{
  "name": "tavernfire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "emulators": "firebase emulators:start",
    "test": "node --test src/lib/*.test.ts functions/src/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tavernfire \"node --test --test-concurrency=1 tests/*.test.ts\"",
    "sync:functions": "node -e \"const fs=require('fs');for(const f of ['ranking','xp'])fs.copyFileSync('src/lib/'+f+'.ts','functions/src/'+f+'.ts')\""
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.36.0",
    "typescript": "^5"
  }
}
