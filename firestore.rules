rules_version = '2';

// Deny everything by default; each collection below opens only what it needs.
// The plan lives in DATA_MODEL.md. Clients never write votes, counts or
// lifecycle state, and author IDs and vote totals are never readable during
// voting (those collections arrive with the voting step).
//
// Answers are written straight from the app as two writes (a private marker,
// then the entry); the rules below tie them together. Voting and the reveal
// still need Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Moderators are marked with a custom claim set from the Admin SDK.
    function isModerator() {
      return signedIn() && request.auth.token.get('role', '') == 'moderator';
    }

    function validWord(v) {
      return v is string && v.size() >= 1 && v.size() <= 24;
    }

    // Display names. A person picks one public name, needed only when they
    // post a request. Keep these checks in step with src/lib/names.ts (a unit
    // test compares the reserved list).
    function validChosenName(n) {
      return n is string && n.size() >= 3 && n.size() <= 20
        && n.matches("^[A-Za-z0-9][A-Za-z0-9 _.'-]*$")
        && !n.matches('.*  .*')
        && !n.matches('.* $');
    }

    // Lower-case, with spaces and punctuation removed ("Dun Gan_01" -> "dungan01").
    function keyOf(n) {
      return n.lower().replace('[ ]', '').replace('_', '').replace('[.]', '')
        .replace("'", '').replace('-', '');
    }

    function allowedKey(k) {
      return k.size() >= 3
        && !(k in ['admin', 'administrator', 'moderator', 'mod', 'staff', 'support',
                   'system', 'official', 'anonymous', 'adventurer', 'you', 'everyone'])
        && !k.matches('.*(tavernfire|moderator|admin).*');
    }

    function nameFree(me) {
      return me.get('nameChangedAt', null) == null
        || request.time > me.nameChangedAt + duration.value(7, 'd');
    }

    // The preset avatars: a pack name and a number, e.g. demon-12. Keep in step with
    // PACKS in src/lib/avatars.ts (a test checks this).
    function validAvatar(a) {
      return a is string && a.matches('(demon|undead)-([1-9]|[1-4][0-9]|50)');
    }

    // A bio: text, at most 280 characters (BIO_MAX in src/lib/bio.ts), no web addresses.
    function validBio(b) {
      return b is string && b.size() <= 280 && !b.matches('(?is).*(https?:|www[.]).*');
    }

    // An avatar can be changed again an hour after the last change.
    function avatarFree(me) {
      return me.get('avatarChangedAt', null) == null
        || request.time > me.avatarChangedAt + duration.value(60, 'm');
    }

    // Public profiles. Anyone can read. The profile starts with no name
    // (displayName null); the owner then claims one through displayNames below.
    match /users/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.displayName == null
        && request.resource.data.createdAt == request.time;

      // Choosing or changing the name: the claim (a displayNames document in
      // this person's name) must already exist, and changes are 7 days apart.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'nameKey', 'nameChangedAt'])
        && validChosenName(request.resource.data.displayName)
        && request.resource.data.nameKey == keyOf(request.resource.data.displayName)
        && get(/databases/$(database)/documents/displayNames/$(request.resource.data.nameKey)).data.uid == uid
        && get(/databases/$(database)/documents/displayNames/$(request.resource.data.nameKey)).data.displayName
             == request.resource.data.displayName
        && request.resource.data.nameChangedAt == request.time
        && nameFree(resource.data);

      // Choosing or changing the avatar: one of the preset ids, at least an hour
      // after the last change. A function (syncAvatar) then copies it onto the
      // member's fires and answers.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['avatar', 'avatarChangedAt'])
        && validAvatar(request.resource.data.avatar)
        && request.resource.data.avatarChangedAt == request.time
        && avatarFree(resource.data);

      // The "about me" text: plain text, short, no web addresses. Empty clears it.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bio'])
        && validBio(request.resource.data.bio);

      allow delete: if false;
    }

    // One document per name, keyed by the lower-case name, so two people
    // cannot hold names that differ only in capitals or punctuation.
    // Known gap: someone could create claims without finishing the profile
    // update and so park names. A Cloud Function will replace this later.
    match /displayNames/{key} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validChosenName(request.resource.data.displayName)
        && key == keyOf(request.resource.data.displayName)
        && allowedKey(key)
        && request.resource.data.createdAt == request.time
        && nameFree(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);

      allow update: if false;

      // Give up an old name once the profile has moved on to another one.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('nameKey', '') != key;
    }

    // A new request must look exactly like what the app sends. The derived
    // search keys are checked against the three sparks so they cannot disagree.
    // (Moving creation to a Cloud Function later will replace these checks.)
    function validNewRequest(d) {
      return d.keys().hasAll([
          'sparks', 'sparksNorm', 'sparkKey', 'pairKeys', 'kind', 'note',
          'requesterId', 'requesterName', 'status', 'moderation',
          'answerCount', 'stokeCount', 'createdAt'
        ])
        && d.keys().hasOnly([
          'sparks', 'sparksNorm', 'sparkKey', 'pairKeys', 'kind', 'note',
          'requesterId', 'requesterName', 'requesterAvatar', 'status', 'moderation',
          'answerCount', 'stokeCount', 'createdAt'
        ])
        && d.requesterId == request.auth.uid
        // The avatar copied onto the fire is the member's current one (absent if none).
        && d.get('requesterAvatar', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('avatar', null)
        && d.requesterName is string
        && d.requesterName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('displayName', null)
        && d.sparks is list && d.sparks.size() == 3
        && validWord(d.sparks[0]) && validWord(d.sparks[1]) && validWord(d.sparks[2])
        && d.sparksNorm is list && d.sparksNorm.size() == 3
        && validWord(d.sparksNorm[0]) && validWord(d.sparksNorm[1]) && validWord(d.sparksNorm[2])
        && d.sparksNorm[0] != d.sparksNorm[1]
        && d.sparksNorm[0] != d.sparksNorm[2]
        && d.sparksNorm[1] != d.sparksNorm[2]
        && d.sparkKey == d.sparksNorm[0] + '|' + d.sparksNorm[1] + '|' + d.sparksNorm[2]
        && d.pairKeys is list && d.pairKeys.size() == 3
        && d.pairKeys[0] == d.sparksNorm[0] + '|' + d.sparksNorm[1]
        && d.pairKeys[1] == d.sparksNorm[0] + '|' + d.sparksNorm[2]
        && d.pairKeys[2] == d.sparksNorm[1] + '|' + d.sparksNorm[2]
        // Keep in step with the launched categories in src/lib/categories.ts
        // (a unit test compares the two).
        && d.kind in ['npc', 'location', 'item', 'creature']
        && d.note is string && d.note.size() <= 300
        && d.status == 'open'
        && d.moderation == 'ok'
        && d.answerCount == 0
        // Starts at 0 so every fire can be sorted by stokes (a missing field would hide it
        // from sorted queries, like the Library's). Only countStokes changes it later.
        && d.stokeCount == 0
        && d.createdAt == request.time;
    }

    // A person's own answer markers across every request, for "Your answers" on
    // the account page. The query must filter on authorId == your uid; reading
    // anyone else's marker (or all of them) is refused.
    match /{path=**}/answerLocks/{uid} {
      allow read: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /requests/{requestId} {
      // Hidden requests are only visible to moderators.
      allow read: if resource.data.moderation == 'ok' || isModerator();
      allow create: if signedIn() && validNewRequest(request.resource.data);
      allow update, delete: if false;

      // Answering is two writes, in this order, each checked against what
      // already exists:
      //   1. requests/{requestId}/answerLocks/{uid}: a private "I'm answering
      //      this request" marker. It records which entry id is mine, so it
      //      doubles as the hidden author record until the reveal. Create-only,
      //      and keyed by the person, so a second answer is refused.
      //   2. entries/{entryId}: the public entry, accepted only if the person's
      //      marker names this entry id. The entry carries its author's id and name.
      match /answerLocks/{uid} {
        // Only the person it belongs to (and moderators) can read it.
        allow read: if signedIn() && (uid == request.auth.uid || isModerator());
        allow create: if signedIn() && uid == request.auth.uid
          && validLock(request.resource.data, requestId);
        allow update, delete: if false;
      }

      // A person's picks for this request: up to three favourite entries.
      // Private: only its owner (and moderators) can read it, so counts stay
      // hidden until the reveal. Picks can be changed until voting ends.
      // Clients never delete ballots; a function removes them after the reveal.
      match /ballots/{uid} {
        allow read: if signedIn() && (uid == request.auth.uid || isModerator());
        allow create, update: if signedIn() && uid == request.auth.uid
          && validBallot(request.resource.data, requestId);
        allow delete: if false;
      }
    }

    // Is this entry a visible entry of this request?
    function pickableEntry(entryId, requestId) {
      let e = get(/databases/$(database)/documents/entries/$(entryId)).data;
      return e.requestId == requestId && e.moderation == 'ok';
    }

    function pickOk(picks, i, requestId) {
      return picks.size() <= i
        || (picks[i] is string && picks[i].size() >= 1 && picks[i].size() <= 40
            && pickableEntry(picks[i], requestId));
    }

    // Voting rules that need no Cloud Function: a verified email, at most three
    // distinct picks, each an entry of this request, never your own entry, and
    // only within 5 days of the request being posted (3 days of answers and
    // voting, then 2 days of voting only), and only while the request has not
    // been revealed or closed by the lifecycle function.
    function validBallot(d, requestId) {
      let rq = get(/databases/$(database)/documents/requests/$(requestId)).data;
      let lockPath = /databases/$(database)/documents/requests/$(requestId)/answerLocks/$(request.auth.uid);
      return d.keys().hasOnly(['voterId', 'requestId', 'picks', 'updatedAt'])
        && d.keys().hasAll(['voterId', 'requestId', 'picks', 'updatedAt'])
        && request.auth.token.get('email_verified', false) == true
        && d.voterId == request.auth.uid
        && d.requestId == requestId
        && d.updatedAt == request.time
        && d.picks is list && d.picks.size() <= 3
        && pickOk(d.picks, 0, requestId)
        && pickOk(d.picks, 1, requestId)
        && pickOk(d.picks, 2, requestId)
        && (d.picks.size() < 2 || d.picks[0] != d.picks[1])
        && (d.picks.size() < 3 || (d.picks[0] != d.picks[2] && d.picks[1] != d.picks[2]))
        && (!exists(lockPath) || !(get(lockPath).data.entryId in d.picks))
        && rq.moderation == 'ok'
        && rq.status in ['open', 'voting']
        && request.time < rq.createdAt + duration.value(5, 'd');
    }

    function validLock(d, requestId) {
      let rq = get(/databases/$(database)/documents/requests/$(requestId)).data;
      return d.keys().hasOnly(['authorId', 'requestId', 'entryId', 'createdAt'])
        && d.keys().hasAll(['authorId', 'requestId', 'entryId', 'createdAt'])
        && d.authorId == request.auth.uid
        && d.requestId == requestId
        && d.entryId is string && d.entryId.size() >= 1 && d.entryId.size() <= 40
        && d.createdAt == request.time
        && rq.moderation == 'ok'
        && rq.requesterId != request.auth.uid;
    }

    function traitOk(list, i) {
      return list.size() <= i
        || (list[i] is string && list[i].size() >= 1 && list[i].size() <= 24);
    }

    // The parts of an entry a person writes (shared by creating and editing).
    function validEntryContent(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.concept is string && d.concept.size() >= 1 && d.concept.size() <= 600
        && d.traits is list && d.traits.size() <= 5
        && d.traitsNorm is list && d.traitsNorm.size() == d.traits.size()
        && traitOk(d.traits, 0) && traitOk(d.traits, 1) && traitOk(d.traits, 2)
        && traitOk(d.traits, 3) && traitOk(d.traits, 4)
        && traitOk(d.traitsNorm, 0) && traitOk(d.traitsNorm, 1) && traitOk(d.traitsNorm, 2)
        && traitOk(d.traitsNorm, 3) && traitOk(d.traitsNorm, 4);
    }

    // Editing your own entry. Allowed only:
    //  - by the person whose private marker names this entry,
    //  - within 24 hours of posting (measured from createdAt, which never changes,
    //    so editing does not restart the clock; keep in step with
    //    ENTRY_EDIT_WINDOW_HOURS in src/lib/entries.ts),
    //  - if nobody has reported the entry (a report adds an entryFlags document),
    //  - changing only name, concept, traits and traitsNorm, and stamping editedAt.
    function validEntryEdit(n, o, entryId) {
      let lock = get(/databases/$(database)/documents/requests/$(o.requestId)/answerLocks/$(request.auth.uid)).data;
      return lock.entryId == entryId
        && o.moderation == 'ok'
        && n.diff(o).affectedKeys().hasOnly(['name', 'concept', 'traits', 'traitsNorm', 'editedAt'])
        && n.editedAt == request.time
        && request.time < o.createdAt + duration.value(24, 'h')
        && !exists(/databases/$(database)/documents/entryFlags/$(entryId))
        && validEntryContent(n);
    }

    // An entry (an answer). It carries its author's id and chosen name from the
    // start (fires are open, answers are not anonymous). The request it answers
    // is looked up, so the checks below cannot be dodged by sending a different
    // kind or different sparks. There is no answer deadline.
    function validNewEntry(d, entryId) {
      let rq = get(/databases/$(database)/documents/requests/$(d.requestId)).data;
      let lock = get(/databases/$(database)/documents/requests/$(d.requestId)/answerLocks/$(request.auth.uid)).data;
      return d.keys().hasOnly([
          'requestId', 'kind', 'name', 'concept', 'traits', 'traitsNorm',
          'sparksNorm', 'sparkKey', 'pairKeys', 'moderation', 'createdAt',
          'authorId', 'authorName', 'authorAvatar', 'upvoteCount'
        ])
        && d.keys().hasAll([
          'requestId', 'kind', 'name', 'concept', 'traits', 'traitsNorm',
          'sparksNorm', 'sparkKey', 'pairKeys', 'moderation', 'createdAt',
          'authorId', 'authorName', 'upvoteCount'
        ])
        // Starts at 0 so every answer can be sorted by upvotes (a missing field would
        // hide it from sorted queries). Only the countUpvotes function changes it later.
        && d.upvoteCount == 0
        && d.authorId == request.auth.uid
        && d.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && d.get('authorAvatar', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('avatar', null)
        && d.requestId is string
        && lock.authorId == request.auth.uid
        && lock.requestId == d.requestId
        && lock.entryId == entryId
        && rq.moderation == 'ok'
        && rq.requesterId != request.auth.uid
        && d.kind == rq.kind
        && d.sparkKey == rq.sparkKey
        && d.sparksNorm == rq.sparksNorm
        && d.pairKeys == rq.pairKeys
        && validEntryContent(d)
        && d.moderation == 'ok'
        && d.createdAt == request.time;
    }

    match /entries/{entryId} {
      allow read: if resource.data.moderation == 'ok' || isModerator();
      allow create: if signedIn() && validNewEntry(request.resource.data, entryId);
      allow update: if signedIn() && validEntryEdit(request.resource.data, resource.data, entryId);
      allow delete: if false;
    }

    // A flag that locks an entry against edits once anyone has reported it. The
    // reporter writes it right after their report (the report must exist). It is
    // never readable by members, so nobody learns which entries were reported.
    match /entryFlags/{entryId} {
      allow read: if isModerator();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['entryId', 'reportId', 'createdAt'])
        && request.resource.data.keys().hasAll(['entryId', 'reportId', 'createdAt'])
        && request.resource.data.entryId == entryId
        && request.resource.data.reportId is string
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.entryId == entryId
        && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.reporterId == request.auth.uid;
      allow update: if false;
      // A moderator who dismisses the report removes the flag, so the author can
      // edit again (if their window has not ended).
      allow delete: if isModerator();
    }

    // Reports ("Report entry"). The id is entryId_reporterUid, so each person
    // can report an entry once. Only the reporter and moderators can read them.
    match /reports/{reportId} {
      allow read: if signedIn()
        && (resource.data.reporterId == request.auth.uid || isModerator());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['entryId', 'reporterId', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['entryId', 'reporterId', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.entryId is string
        && reportId == request.resource.data.entryId + '_' + request.auth.uid
        && request.resource.data.reason in ['ai_generated', 'plagiarism', 'spam', 'abuse', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/entries/$(request.resource.data.entryId));
      allow update, delete: if false;
    }

    // Upvotes on answers. One document per person per answer, with the id
    // entryId_uid, so a second upvote is the same document and is refused. Created
    // and deleted only by the voter. Needs a verified email, and you cannot upvote
    // your own answer (the entry carries its author's id). The total shown on an
    // answer (upvoteCount on the entry) is kept by a Cloud Function, never the app.
    function validUpvote(upvoteId, d) {
      let entry = get(/databases/$(database)/documents/entries/$(d.entryId)).data;
      return d.keys().hasOnly(['entryId', 'requestId', 'voterId', 'createdAt'])
        && d.keys().hasAll(['entryId', 'requestId', 'voterId', 'createdAt'])
        && d.voterId == request.auth.uid
        && d.entryId is string
        && upvoteId == d.entryId + '_' + request.auth.uid
        && d.requestId == entry.requestId
        && d.createdAt == request.time
        && request.auth.token.email_verified == true
        && entry.moderation == 'ok'
        && entry.get('authorId', '') != request.auth.uid;
    }

    // Notifications (a stoke, an upvote, an answer, an achievement, a new rank). Only
    // functions create them. Their owner reads them and can mark one read; nothing else.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    match /upvotes/{upvoteId} {
      // Only your own, so a person can list what they have upvoted on a fire
      // (the query must filter on voterId == your uid).
      allow read: if signedIn() && resource.data.voterId == request.auth.uid;
      allow create: if signedIn() && validUpvote(upvoteId, request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.voterId == request.auth.uid;
    }

    // Stokes on fires ("good fire"). Same shape as upvotes: one document per person per
    // fire, id requestId_uid, created and deleted only by the person, verified email,
    // and you cannot stoke your own fire. The total (stokeCount) and the trending rank
    // on the request are kept by Cloud Functions, never the app.
    function validStoke(stokeId, d) {
      let rq = get(/databases/$(database)/documents/requests/$(d.requestId)).data;
      return d.keys().hasOnly(['requestId', 'voterId', 'createdAt'])
        && d.keys().hasAll(['requestId', 'voterId', 'createdAt'])
        && d.voterId == request.auth.uid
        && d.requestId is string
        && stokeId == d.requestId + '_' + request.auth.uid
        && d.createdAt == request.time
        && request.auth.token.email_verified == true
        && rq.moderation == 'ok'
        && rq.requesterId != request.auth.uid;
    }

    match /stokes/{stokeId} {
      // The fire page reads your own stoke by its id; when you have not stoked, that
      // document does not exist, so `resource` is null and must be allowed (it reveals nothing).
      allow read: if signedIn() && (resource == null || resource.data.voterId == request.auth.uid);
      allow create: if signedIn() && validStoke(stokeId, request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.voterId == request.auth.uid;
    }

    // The list of sparks in use, for suggestions on the Light a fire form.
    // Anyone can read it; only the countSparks Cloud Function writes it.
    match /sparks/{word} {
      allow read: if true;
      allow write: if false;
    }
  }
}
