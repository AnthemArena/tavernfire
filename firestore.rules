rules_version = '2';

// Deny everything by default; each collection below opens only what it needs.
// The plan lives in DATA_MODEL.md. Clients never write votes, counts or
// lifecycle state, and author IDs and vote totals are never readable during
// voting (those collections arrive with the voting step).
//
// Answers are written straight from the app as two writes (a private marker,
// then the entry); the rules below tie them together. Voting and the reveal
// still need Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Moderators are marked with a custom claim set from the Admin SDK.
    function isModerator() {
      return signedIn() && request.auth.token.get('role', '') == 'moderator';
    }

    function validName(v) {
      return v is string && v.size() >= 1 && v.size() <= 40;
    }

    function validWord(v) {
      return v is string && v.size() >= 1 && v.size() <= 30;
    }

    function validAvatar(d) {
      return !('avatarUrl' in d)
        || d.avatarUrl == null
        || (d.avatarUrl is string && d.avatarUrl.size() <= 500);
    }

    // Public profiles. Anyone can read; only the owner can create or edit.
    match /users/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['displayName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'avatarUrl', 'createdAt'])
        && validName(request.resource.data.displayName)
        && validAvatar(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarUrl'])
        && validName(request.resource.data.displayName)
        && validAvatar(request.resource.data);

      allow delete: if false;
    }

    // A new request must look exactly like what the app sends. The derived
    // search keys are checked against the three sparks so they cannot disagree.
    // (Moving creation to a Cloud Function later will replace these checks.)
    function validNewRequest(d) {
      return d.keys().hasAll([
          'sparks', 'sparksNorm', 'sparkKey', 'pairKeys', 'kind', 'note',
          'requesterId', 'requesterName', 'status', 'moderation',
          'answerCount', 'createdAt'
        ])
        && d.keys().hasOnly([
          'sparks', 'sparksNorm', 'sparkKey', 'pairKeys', 'kind', 'note',
          'requesterId', 'requesterName', 'status', 'moderation',
          'answerCount', 'createdAt'
        ])
        && d.requesterId == request.auth.uid
        && validName(d.requesterName)
        && d.sparks is list && d.sparks.size() == 3
        && validWord(d.sparks[0]) && validWord(d.sparks[1]) && validWord(d.sparks[2])
        && d.sparksNorm is list && d.sparksNorm.size() == 3
        && validWord(d.sparksNorm[0]) && validWord(d.sparksNorm[1]) && validWord(d.sparksNorm[2])
        && d.sparksNorm[0] != d.sparksNorm[1]
        && d.sparksNorm[0] != d.sparksNorm[2]
        && d.sparksNorm[1] != d.sparksNorm[2]
        && d.sparkKey == d.sparksNorm[0] + '|' + d.sparksNorm[1] + '|' + d.sparksNorm[2]
        && d.pairKeys is list && d.pairKeys.size() == 3
        && d.pairKeys[0] == d.sparksNorm[0] + '|' + d.sparksNorm[1]
        && d.pairKeys[1] == d.sparksNorm[0] + '|' + d.sparksNorm[2]
        && d.pairKeys[2] == d.sparksNorm[1] + '|' + d.sparksNorm[2]
        // Keep in step with the launched categories in src/lib/categories.ts
        // (a unit test compares the two).
        && d.kind in ['npc', 'location', 'item', 'creature']
        && d.note is string && d.note.size() <= 300
        && d.status == 'open'
        && d.moderation == 'ok'
        && d.answerCount == 0
        && d.createdAt == request.time;
    }

    match /requests/{requestId} {
      // Hidden requests are only visible to moderators.
      allow read: if resource.data.moderation == 'ok' || isModerator();
      allow create: if signedIn() && validNewRequest(request.resource.data);
      allow update, delete: if false;

      // Answering is two writes, in this order, each checked against what
      // already exists:
      //   1. requests/{requestId}/answerLocks/{uid}: a private "I'm answering
      //      this request" marker. It records which entry id is mine, so it
      //      doubles as the hidden author record until the reveal. Create-only,
      //      and keyed by the person, so a second answer is refused.
      //   2. entries/{entryId}: the public entry, accepted only if the person's
      //      marker names this entry id. The entry never holds its author.
      match /answerLocks/{uid} {
        // Only the person it belongs to (and moderators) can read it.
        allow read: if signedIn() && (uid == request.auth.uid || isModerator());
        allow create: if signedIn() && uid == request.auth.uid
          && validLock(request.resource.data, requestId);
        allow update, delete: if false;
      }
    }

    function validLock(d, requestId) {
      let rq = get(/databases/$(database)/documents/requests/$(requestId)).data;
      return d.keys().hasOnly(['authorId', 'requestId', 'entryId', 'createdAt'])
        && d.keys().hasAll(['authorId', 'requestId', 'entryId', 'createdAt'])
        && d.authorId == request.auth.uid
        && d.requestId == requestId
        && d.entryId is string && d.entryId.size() >= 1 && d.entryId.size() <= 40
        && d.createdAt == request.time
        && rq.moderation == 'ok'
        && rq.status == 'open'
        && request.time < rq.createdAt + duration.value(3, 'd')
        && rq.requesterId != request.auth.uid;
    }

    function traitOk(list, i) {
      return list.size() <= i
        || (list[i] is string && list[i].size() >= 1 && list[i].size() <= 24);
    }

    // The parts of an entry a person writes (shared by creating and editing).
    function validEntryContent(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.concept is string && d.concept.size() >= 1 && d.concept.size() <= 600
        && d.traits is list && d.traits.size() <= 5
        && d.traitsNorm is list && d.traitsNorm.size() == d.traits.size()
        && traitOk(d.traits, 0) && traitOk(d.traits, 1) && traitOk(d.traits, 2)
        && traitOk(d.traits, 3) && traitOk(d.traits, 4)
        && traitOk(d.traitsNorm, 0) && traitOk(d.traitsNorm, 1) && traitOk(d.traitsNorm, 2)
        && traitOk(d.traitsNorm, 3) && traitOk(d.traitsNorm, 4);
    }

    // Editing your own entry. Allowed only:
    //  - by the person whose private marker names this entry,
    //  - within 24 hours of posting (measured from createdAt, which never changes,
    //    so editing does not restart the clock; keep in step with
    //    ENTRY_EDIT_WINDOW_HOURS in src/lib/entries.ts),
    //  - while the request still accepts answers,
    //  - if nobody has reported the entry (a report adds an entryFlags document),
    //  - changing only name, concept, traits and traitsNorm, and stamping editedAt.
    function validEntryEdit(n, o, entryId) {
      let rq = get(/databases/$(database)/documents/requests/$(o.requestId)).data;
      let lock = get(/databases/$(database)/documents/requests/$(o.requestId)/answerLocks/$(request.auth.uid)).data;
      return lock.entryId == entryId
        && o.moderation == 'ok'
        && n.diff(o).affectedKeys().hasOnly(['name', 'concept', 'traits', 'traitsNorm', 'editedAt'])
        && n.editedAt == request.time
        && request.time < o.createdAt + duration.value(24, 'h')
        && request.time < rq.createdAt + duration.value(3, 'd')
        && !exists(/databases/$(database)/documents/entryFlags/$(entryId))
        && validEntryContent(n);
    }

    // An entry (an answer). It never holds its author. The request it answers is
    // looked up, so the checks below cannot be dodged by sending a different
    // kind, different sparks, or answering after the 3-day window.
    function validNewEntry(d, entryId) {
      let rq = get(/databases/$(database)/documents/requests/$(d.requestId)).data;
      let lock = get(/databases/$(database)/documents/requests/$(d.requestId)/answerLocks/$(request.auth.uid)).data;
      return d.keys().hasOnly([
          'requestId', 'kind', 'name', 'concept', 'traits', 'traitsNorm',
          'sparksNorm', 'sparkKey', 'pairKeys', 'moderation', 'createdAt'
        ])
        && d.keys().hasAll([
          'requestId', 'kind', 'name', 'concept', 'traits', 'traitsNorm',
          'sparksNorm', 'sparkKey', 'pairKeys', 'moderation', 'createdAt'
        ])
        && d.requestId is string
        && lock.authorId == request.auth.uid
        && lock.requestId == d.requestId
        && lock.entryId == entryId
        && rq.moderation == 'ok'
        && rq.status == 'open'
        && request.time < rq.createdAt + duration.value(3, 'd')
        && rq.requesterId != request.auth.uid
        && d.kind == rq.kind
        && d.sparkKey == rq.sparkKey
        && d.sparksNorm == rq.sparksNorm
        && d.pairKeys == rq.pairKeys
        && validEntryContent(d)
        && d.moderation == 'ok'
        && d.createdAt == request.time;
    }

    match /entries/{entryId} {
      allow read: if resource.data.moderation == 'ok' || isModerator();
      allow create: if signedIn() && validNewEntry(request.resource.data, entryId);
      allow update: if signedIn() && validEntryEdit(request.resource.data, resource.data, entryId);
      allow delete: if false;
    }

    // A flag that locks an entry against edits once anyone has reported it. The
    // reporter writes it right after their report (the report must exist). It is
    // never readable by members, so nobody learns which entries were reported.
    match /entryFlags/{entryId} {
      allow read: if isModerator();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['entryId', 'reportId', 'createdAt'])
        && request.resource.data.keys().hasAll(['entryId', 'reportId', 'createdAt'])
        && request.resource.data.entryId == entryId
        && request.resource.data.reportId is string
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.entryId == entryId
        && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.reporterId == request.auth.uid;
      allow update: if false;
      // A moderator who dismisses the report removes the flag, so the author can
      // edit again (if their window has not ended).
      allow delete: if isModerator();
    }

    // Reports ("Report entry"). The id is entryId_reporterUid, so each person
    // can report an entry once. Only the reporter and moderators can read them.
    match /reports/{reportId} {
      allow read: if signedIn()
        && (resource.data.reporterId == request.auth.uid || isModerator());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['entryId', 'reporterId', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['entryId', 'reporterId', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.entryId is string
        && reportId == request.resource.data.entryId + '_' + request.auth.uid
        && request.resource.data.reason in ['ai_generated', 'plagiarism', 'spam', 'abuse', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/entries/$(request.resource.data.entryId));
      allow update, delete: if false;
    }
  }
}
